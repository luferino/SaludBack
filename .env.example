# Server
PORT=3000

# Database
DATABASE_URL=postgres://localhost:5432/saludback

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
BCRYPT_COST=12
# Optional: kid stamped into new tokens (default "current")
# JWT_SECRET_KID=
# Optional: previous secrets still accepted for verification, JSON array of {"kid","secret"}
# JWT_PREVIOUS_SECRETS=

# Password recovery
CLIENT_URL=http://localhost:3000/reset
RESET_TOKEN_TTL=15
RESET_TOKEN_MAX_OUTSTANDING=3
